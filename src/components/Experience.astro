---
import SectionHeading from "./SectionHeading.astro";
---
<section class="content-section" id="experience">
  <div class="section-shell">
    <SectionHeading index="02" eyebrow="THE JOURNEY" title="Building with" accent="purpose." />
    <div class="timeline">
      <div class="timeline-rail"><span></span></div>
      <article class="timeline-entry" data-reveal>
        <div class="timeline-meta"><span class="timeline-dot"></span><span>MAY 2025 — PRESENT</span><span class="meta-line"></span><b>01</b></div>
        <div class="timeline-content">
          <p class="eyebrow">MEYI CLOUD SOLUTIONS PRIVATE LIMITED</p>
          <h3>Associate Software Developer</h3>
          <p class="timeline-summary">Building backend services and cloud-based applications for production systems, with a focus on API design, data integrity, authentication, and operational reliability.</p>
          <ul><li>Developing TypeScript and Node.js services using NestJS and serverless AWS components.</li><li>Designing PostgreSQL-backed APIs and multi-tenant application workflows.</li><li>Contributing to a healthcare RIS/PACS platform across appointment, study, reporting, and imaging workflows.</li><li>Working with Docker, automated testing, monitoring, and performance troubleshooting.</li></ul>
          <div class="tag-list"><span>TypeScript</span><span>NestJS</span><span>PostgreSQL</span><span>AWS</span><span>Docker</span></div>
        </div>
      </article>
      <article class="timeline-entry education-entry" data-reveal>
        <div class="timeline-meta"><span class="timeline-dot"></span><span>EDUCATION</span><span class="meta-line"></span><b>02</b></div>
        <div class="timeline-content"><p class="eyebrow">ANNAMALAI UNIVERSITY</p><h3>B.E. — Computer Science & Engineering</h3><p class="timeline-summary">Data Science specialization.</p></div>
      </article>
    </div>
  </div>
</section>