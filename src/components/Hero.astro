---
const tags = ["TypeScript", "NestJS", "AWS", "PostgreSQL"];
---
<section class="hero section-shell" id="top">
  <div class="hero-grid">
    <div class="hero-copy">
      <p class="eyebrow hero-eyebrow"><span class="eyebrow-dot"></span> ASSOCIATE SOFTWARE DEVELOPER <span class="eyebrow-line"></span> INDIA</p>
      <h1 class="hero-title"><span class="title-line">Engineering</span><span class="title-line title-outline">what's next<span class="cyan">.</span></span></h1>
      <p class="hero-intro">I'm Kumaresan — a software developer focused on backend engineering, cloud systems, and building dependable products that solve real problems.</p>
      <div class="hero-actions">
        <a class="button button-primary magnetic" href="#projects">Explore my work <span>↘</span></a>
        <a class="button button-quiet" href="Kumaresan.pdf" target="_blank" rel="noopener">View résumé <span>↗</span></a>
      </div>
      <div class="hero-stack"><span>CORE TOOLKIT</span>{tags.map(tag => <b>{tag}</b>)}</div>
    </div>
    <div class="hero-art" data-parallax="0.12">
      <div class="orbit orbit-one"></div><div class="orbit orbit-two"></div>
      <svg class="morph-orb" viewBox="0 0 520 520" role="presentation" aria-hidden="true"><defs><linearGradient id="orbGradient" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#41e2ed"/><stop offset=".52" stop-color="#167cba"/><stop offset="1" stop-color="#10294b"/></linearGradient><filter id="orbGlow"><feGaussianBlur stdDeviation="18"/></filter></defs><path class="orb-glow" d="M260 38C382 32 475 136 474 258C473 382 370 482 250 474C126 466 39 374 45 250C51 126 138 44 260 38Z" fill="#20cbe5" filter="url(#orbGlow)" opacity=".28"/><path class="orb-shape" d="M260 38C382 32 475 136 474 258C473 382 370 482 250 474C126 466 39 374 45 250C51 126 138 44 260 38Z" fill="url(#orbGradient)" opacity=".2" stroke="#49dce9" stroke-opacity=".62" stroke-width="1.4"/></svg>
      <div class="portrait-frame"><img src="/Kumaresan%20K.jpg" alt="Portrait of Kumaresan Kanthasamy" fetchpriority="high" /></div>
      <span class="float-label label-code">{" backend.ts "}</span><span class="float-label label-cloud">☁ CLOUD SYSTEMS</span><span class="float-label label-api">API · DATA · SCALE</span>
      <span class="art-index">01 / 05</span>
    </div>
  </div>
  <a class="scroll-cue" href="#about"><span class="scroll-cue-line"></span> SCROLL TO EXPLORE</a>
</section>