---
import "../styles/clean.css";
import NetworkBackground from "../components/NetworkBackground.tsx";

const {
  title = "Kumaresan Kanthasamy — Backend & Cloud Systems Engineer",
  description = "Backend and cloud engineer building serverless systems, zero-trust databases and microservices with TypeScript, Node.js, PostgreSQL and AWS.",
  noindex = false
} = Astro.props;

const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Kumaresan Kanthasamy",
  jobTitle: "Backend & Cloud Systems Engineer",
  url: "https://kumaresan.is-a.dev/",
  image: "https://kumaresan.is-a.dev/Kumaresan%20K.jpg",
  sameAs: ["https://github.com/kuman002", "https://www.linkedin.com/in/kumaresan-k-4289452b4"]
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Hide reveal items only while JS works; if the module script never loads (e.g. stale cached HTML after a deploy), unhide after 3s.
      const root = document.documentElement;
      root.classList.add("js");
      setTimeout(() => root.hasAttribute("data-revealed") || root.classList.remove("js"), 3000);
    </script>
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href="https://kumaresan.is-a.dev/" />}
    <meta name="theme-color" content="#090d14" />
    <meta name="description" content={description} />
    <meta name="author" content="Kumaresan Kanthasamy" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500;600&family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />
    <!-- Favicon & Icons for all browsers and search engines -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Kumaresan Kanthasamy" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://kumaresan.is-a.dev/" />
    <meta property="og:image" content="https://kumaresan.is-a.dev/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Kumaresan Kanthasamy — Backend & Cloud Systems Engineer" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    <!-- Site name shown in Google results instead of "is-a.dev" -->
    <script type="application/ld+json" set:html={JSON.stringify({ "@context": "https://schema.org", "@type": "WebSite", name: "Kumaresan Kanthasamy", alternateName: ["Kumaresan K"], url: "https://kumaresan.is-a.dev/" })} />
    <title>{title}</title>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <!-- Top Scroll Progress Indicator -->
    <div class="scroll-progress-bar" aria-hidden="true"></div>

    <!-- Software Engineer Distributed Network & Data Flow Background Animation -->
    <NetworkBackground client:idle />

    <slot />

    <script>
      import { initSmoothScroll } from "../animations/smoothScroll";
      initSmoothScroll();
    </script>
  </body>
</html>
