---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import Hero from "../components/Hero.astro";
import SectionHeading from "../components/SectionHeading.astro";
import Experience from "../components/Experience.astro";
import Skills from "../components/Skills.astro";
import Projects from "../components/Projects.astro";
import Contact from "../components/Contact.astro";
---
<BaseLayout>
  <SiteHeader />
  <main>
    <Hero />
    <section class="about-section content-section" id="about">
      <div class="section-shell about-grid">
        <div><SectionHeading index="01" eyebrow="A LITTLE ABOUT ME" title="Curious by nature," accent="engineer by craft." /></div>
        <div class="about-copy" data-reveal><p>I enjoy understanding how systems work, finding the right abstraction, and turning complex requirements into software people can depend on.</p><p>My work sits mainly around backend development and cloud engineering — designing APIs, working with data, and improving the reliability of production systems.</p><p>Outside the code, I'm continuously learning across distributed systems, cloud architecture, and applied AI.</p><a class="text-link" href="Kumaresan.pdf" target="_blank" rel="noopener">A little more on my résumé <span>↗</span></a></div>
      </div>
    </section>
    <Experience />
    <Skills />
    <Projects />
    <Contact />
  </main>
</BaseLayout>