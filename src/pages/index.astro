---
import BaseLayout from "../layouts/BaseLayout.astro";

const projects = [
  {
    n: "01",
    type: "AI · BACKEND ARCHITECTURE · CDC",
    name: "DB-Native RAG Chatbot Widget",
    desc: "Production-ready embeddable chatbot system synchronizing knowledge from operational databases via Change Data Capture (CDC), PostgreSQL triggers, Redis BullMQ queues, and pgvector embeddings for low-latency streaming answers.",
    stack: ["TypeScript", "PostgreSQL", "pgvector", "Redis", "BullMQ", "OpenAI"],
    url: "https://github.com/kuman002/db-native-rag-widget"
  },
  {
    n: "02",
    type: "OFFLINE AI · DESKTOP AUTOMATION",
    name: "M.I.L.O. — Offline AI Assistant",
    desc: "Privacy-focused, fully offline desktop assistant engineered with Python and PyQt5. Employs Vosk for offline voice recognition, local NLP processing, and native OS automation for task scheduling and finance tracking without internet access.",
    stack: ["Python", "PyQt5", "Vosk", "Local NLP", "Automation", "SQLite"],
    url: "https://github.com/kuman002/M.I.L.O"
  },
  {
    n: "03",
    type: "AGENTIC WORKFLOWS · LANGGRAPH",
    name: "Agentic AI Backend",
    desc: "Autonomous multi-agent orchestration service built on LangGraph and FastAPI. Features ChromaDB vector storage, semantic query routing, real-time web search fallback, and multi-turn stateful conversational memory.",
    stack: ["Python", "LangGraph", "FastAPI", "ChromaDB", "RAG", "LangChain"],
    url: "https://github.com/kuman002/agentic-backend"
  },
  {
    n: "04",
    type: "FASTAPI · MULTI-AGENT · WEB SEARCH",
    name: "Agentic AI Chatbot",
    desc: "Intelligent conversational agent integrating Tavily live web search, dynamic tool invocation, and streaming response delivery over FastAPI.",
    stack: ["Python", "FastAPI", "LangChain", "Tavily API", "Streaming", "Pydantic"],
    url: "https://github.com/kuman002/agentic-ai-backend"
  },
  {
    n: "05",
    type: "RAG · LLAMA · VECTOR RETRIEVAL",
    name: "Academic Notes Intelligence System",
    desc: "RAG-powered academic document Q&A engine utilizing ChromaDB vector embeddings and localized Llama models to deliver grounded, hallucination-resistant answers with precise page-level citations.",
    stack: ["Python", "Flask", "ChromaDB", "Llama", "LangChain", "PyPDF"],
    url: "https://github.com/kuman002/academic-notes-ai"
  },
  {
    n: "06",
    type: "DATA PIPELINE · PLAYWRIGHT · ETL",
    name: "Slooze Data Engineering Challenge",
    desc: "Robust industrial web scraper and ETL transformation pipeline targeting IndiaMART catalog listings using Playwright. Features resilient retry mechanics, structured schema validation, and automated reporting.",
    stack: ["Python", "Playwright", "ETL", "Pandas", "Data Validation", "BeautifulSoup"],
    url: "https://github.com/kuman002/slooze-take-home-challenge"
  },
  {
    n: "07",
    type: "DATA SCIENCE · PROBABILISTIC MODELING",
    name: "Customer Lifetime Value (CLV) Prediction",
    desc: "E-commerce customer transaction modeling using BG/NBD and Gamma-Gamma probabilistic models alongside RFM segmentation to forecast customer churn and 12-month expected customer monetary value.",
    stack: ["Python", "BG/NBD", "Gamma-Gamma", "RFM Analysis", "Scikit-learn"],
    url: "https://github.com/kuman002/customer-lifetime-value-CLV"
  }
];

const skillGroups = [
  { name: "Backend Services", items: ["Node.js", "TypeScript", "NestJS", "FastAPI", "Python", "REST APIs", "Microservices"] },
  { name: "Database & Caching", items: ["PostgreSQL", "Drizzle ORM", "Redis", "BullMQ", "pgvector", "SQL Optimization", "Prisma"] },
  { name: "Cloud & DevSecOps", items: ["AWS Lambda", "AWS Cognito", "API Gateway", "RDS", "Docker", "S3", "AES-256-GCM"] },
  { name: "Applied AI & Systems", items: ["LangGraph", "ChromaDB", "RAG Systems", "Playwright ETL", "NLP (Vosk)", "Git"] }
];
---
<BaseLayout>
  <!-- Clean Sticky Navigation Header -->
  <header class="nav-header">
    <div class="container nav-container">
      <a href="#hero" class="nav-logo" aria-label="Kumaresan Kanthasamy Homepage">
        <span class="logo-badge">KK</span>
        <span>Kumaresan K</span>
      </a>
      <nav aria-label="Main Navigation">
        <ul class="nav-links">
          <li><a href="#about">About</a></li>
          <li><a href="#experience">Experience</a></li>
          <li><a href="#projects">Projects</a></li>
          <li><a href="#skills">Skills</a></li>
          <li><a href="#contact">Contact</a></li>
        </ul>
      </nav>
      <a href="Kumaresan.pdf" target="_blank" rel="noopener" class="nav-cta">
        <span>Résumé</span>
        <span aria-hidden="true">↗</span>
      </a>
    </div>
  </header>

  <main>
    <!-- Hero Section -->
    <section id="hero" class="hero-section">
      <div class="container hero-grid">
        <div class="hero-content reveal-item">
          <div class="status-pill">
            <span class="status-dot"></span>
            <span>Available for Backend & Cloud Roles</span>
          </div>
          <h1 class="hero-title">
            Engineering reliable backends & cloud architectures.
          </h1>
          <p class="hero-subtitle">
            Associate Software Developer · India
          </p>
          <p class="hero-description">
            I'm Kumaresan — a backend engineer building resilient cloud architectures, high-concurrency microservices, and zero-trust encrypted database systems with TypeScript, Node.js, PostgreSQL, and AWS.
          </p>
          <div class="hero-actions">
            <a href="#contact" class="btn btn-primary">
              <span>Start a conversation</span>
              <span aria-hidden="true">→</span>
            </a>
            <a href="Kumaresan.pdf" target="_blank" rel="noopener" class="btn btn-secondary">
              <span>View Résumé</span>
              <span aria-hidden="true">↗</span>
            </a>
            <a href="https://github.com/kuman002" target="_blank" rel="noopener" class="btn btn-ghost">
              <span>GitHub</span>
              <span aria-hidden="true">↗</span>
            </a>
            <a href="https://www.linkedin.com/in/kumaresan-k-4289452b4" target="_blank" rel="noopener" class="btn btn-ghost">
              <span>LinkedIn</span>
              <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>

        <div class="hero-visual reveal-item stagger-2">
          <div class="portrait-wrapper">
            <img src="/Kumaresan%20K.jpg" alt="Portrait of Kumaresan Kanthasamy" fetchpriority="high" />
            <div class="portrait-tag">
              <span>KUMARESAN K</span>
              <span>BACKEND ENG</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Key Metrics / System Highlights -->
    <section class="metrics-section" aria-label="Engineering Performance Metrics">
      <div class="container">
        <div class="metrics-grid">
          <div class="metric-card reveal-item stagger-1">
            <div class="metric-val">99.99%</div>
            <div class="metric-lbl">Uptime Target</div>
            <div class="metric-desc">Cloud-native architectures engineered for fault-tolerant operation</div>
          </div>
          <div class="metric-card reveal-item stagger-2">
            <div class="metric-val">&lt; 35ms</div>
            <div class="metric-lbl">p99 Latency</div>
            <div class="metric-desc">Optimized SQL query paths and Redis caching layers</div>
          </div>
          <div class="metric-card reveal-item stagger-3">
            <div class="metric-val">AES-256</div>
            <div class="metric-lbl">Zero-Trust</div>
            <div class="metric-desc">Application-level envelope cipher & blind index search</div>
          </div>
          <div class="metric-card reveal-item stagger-4">
            <div class="metric-val">7+ Systems</div>
            <div class="metric-lbl">Shipped</div>
            <div class="metric-desc">Production platforms, agentic AI backends, and data ETL pipelines</div>
          </div>
        </div>
      </div>
    </section>

    <!-- Experience Section -->
    <section id="experience" class="section-block">
      <div class="container">
        <div class="section-head reveal-item">
          <p class="section-eyebrow">Career & Production Experience</p>
          <h2 class="section-title">Where I've built.</h2>
        </div>

        <div class="exp-timeline">
          <!-- Experience Item 1 -->
          <article class="exp-card reveal-item">
            <div class="exp-card-header">
              <div>
                <h3 class="exp-role">Serverless Backend Architecture & Cloud Systems</h3>
                <div class="exp-company">Meyi Cloud Solutions Private Limited · Associate Software Developer</div>
              </div>
              <span class="exp-badge">Proprietary System</span>
            </div>
            <ul class="exp-points">
              <li>Engineered AWS Cognito authentication flows covering user registration, SMS/email OTP verification, and hardened JWT token parsing for stateless session management.</li>
              <li>Architected application-level data encryption using AES-256-GCM combined with HMAC-SHA256 blind indexing to store and search sensitive patient and customer records safely inside AWS RDS PostgreSQL.</li>
              <li>Constructed high-throughput ticket management microservices with Drizzle ORM and PostgreSQL, pushing complex state validations directly into the database engine via SQL CASE expressions and NULL-safe <code>IS DISTINCT FROM</code> clauses.</li>
              <li>Standardized API Gateway JSON Schema validation contracts and packaged common utilities into reusable AWS Lambda Layers.</li>
            </ul>
            <div class="tech-tags">
              <span class="tech-tag">TypeScript</span>
              <span class="tech-tag">Node.js</span>
              <span class="tech-tag">AWS Lambda</span>
              <span class="tech-tag">AWS Cognito</span>
              <span class="tech-tag">PostgreSQL</span>
              <span class="tech-tag">Drizzle ORM</span>
              <span class="tech-tag">AES-256-GCM</span>
            </div>
          </article>

          <!-- Experience Item 2 -->
          <article class="exp-card reveal-item">
            <div class="exp-card-header">
              <div>
                <h3 class="exp-role">Healthcare RIS/PACS Platform (7XT RIS/PACS)</h3>
                <div class="exp-company">Meyi Cloud Solutions Private Limited · Sanitized Case Study</div>
              </div>
              <span class="exp-badge">Healthcare Platform</span>
            </div>
            <ul class="exp-points">
              <li>Designed backend RESTful APIs orchestrating multi-modality patient appointments, radiologist study worklists, and structured diagnostic reporting pipelines.</li>
              <li>Ensured clinical data consistency across multi-tenant hospital environments through transactional PostgreSQL schemas, database constraints, and DICOM metadata tagging.</li>
              <li>Packaged modular backend services into Docker containers, optimized complex relational queries for high-volume imaging records, and monitored operational health metrics on AWS.</li>
            </ul>
            <div class="tech-tags">
              <span class="tech-tag">TypeScript</span>
              <span class="tech-tag">NestJS</span>
              <span class="tech-tag">PostgreSQL</span>
              <span class="tech-tag">AWS</span>
              <span class="tech-tag">Docker</span>
              <span class="tech-tag">DICOM</span>
              <span class="tech-tag">Microservices</span>
            </div>
          </article>

          <!-- Education -->
          <article class="exp-card reveal-item">
            <div class="exp-card-header">
              <div>
                <h3 class="exp-role">B.E. — Computer Science & Engineering</h3>
                <div class="exp-company">Annamalai University · 2021 — 2025 · Data Science Specialization</div>
              </div>
              <span class="exp-badge">Education</span>
            </div>
            <p style="color: var(--text-muted); font-size: 0.95rem; margin-top: 0.5rem;">
              Core coursework completed across distributed systems, database management systems, algorithms, and applied machine learning.
            </p>
          </article>
        </div>
      </div>
    </section>

    <!-- Projects Section -->
    <section id="projects" class="section-block">
      <div class="container">
        <div class="section-head reveal-item">
          <p class="section-eyebrow">Open Source & Personal Work</p>
          <h2 class="section-title">Engineered projects.</h2>
        </div>

        <div class="projects-grid">
          {projects.map((p, idx) => (
            <a class={`project-card reveal-item stagger-${(idx % 4) + 1}`} href={p.url} target="_blank" rel="noopener noreferrer">
              <div>
                <div class="project-card-top">
                  <span class="project-category">{p.type}</span>
                  <span class="project-arrow-icon" aria-hidden="true">↗</span>
                </div>
                <h3 class="project-title">{p.name}</h3>
                <p class="project-desc">{p.desc}</p>
              </div>
              <div class="tech-tags" style="margin-top: 0; padding-top: 1rem;">
                {p.stack.map((item) => <span class="tech-tag">{item}</span>)}
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Skills Section -->
    <section id="skills" class="section-block">
      <div class="container">
        <div class="section-head reveal-item">
          <p class="section-eyebrow">Technical Capabilities</p>
          <h2 class="section-title">Core toolkit.</h2>
        </div>

        <div class="skills-grid">
          {skillGroups.map((group, idx) => (
            <div class={`skill-category-card reveal-item stagger-${idx + 1}`}>
              <h3 class="skill-cat-title">
                <span>{group.name}</span>
                <span>0{idx + 1}</span>
              </h3>
              <div class="skill-pills">
                {group.items.map((item) => <span class="skill-pill">{item}</span>)}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- About Section -->
    <section id="about" class="section-block">
      <div class="container">
        <div class="section-head reveal-item">
          <p class="section-eyebrow">Engineering Background</p>
          <h2 class="section-title">About my work.</h2>
        </div>

        <div class="about-grid">
          <div class="about-text reveal-item">
            <p>
              I enjoy understanding how software operates under high concurrency, designing clean abstractions, and turning complex product requirements into dependable, low-latency backend architectures.
            </p>
            <p>
              My primary focus centers on event-driven microservices, cloud deployments on AWS, and PostgreSQL schemas protected by zero-trust database encryption. I care deeply about strict data integrity, zero-drift contracts, and deterministic performance.
            </p>
            <p>
              Outside production responsibilities, I experiment with distributed systems, LangGraph agentic workflows, Change Data Capture (CDC) pipelines, and applied AI tools.
            </p>
            <div>
              <a href="Kumaresan.pdf" target="_blank" rel="noopener" class="btn btn-secondary" style="margin-top: 0.5rem;">
                <span>Read detailed résumé</span>
                <span aria-hidden="true">↗</span>
              </a>
            </div>
          </div>

          <div class="about-sidebar reveal-item stagger-2">
            <div class="about-fact-card">
              <h4>System Reliability</h4>
              <p>Designing for graceful failure, circuit breaking, idempotency, and clean database transaction boundaries.</p>
            </div>
            <div class="about-fact-card">
              <h4>Zero-Trust Security</h4>
              <p>Application-level cryptography with AES-256-GCM and blind indexes to safeguard sensitive customer and healthcare records.</p>
            </div>
            <div class="about-fact-card">
              <h4>Modern Backend Stack</h4>
              <p>TypeScript, Node.js, NestJS, FastAPI, PostgreSQL, Redis BullMQ queues, Docker, and AWS Serverless.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Contact Section -->
    <section id="contact" class="section-block">
      <div class="container">
        <div class="contact-card reveal-item">
          <p class="section-eyebrow" style="color: var(--accent);">Get in Touch</p>
          <h2 class="section-title">Let's build something dependable.</h2>
          <p>
            I'm always open to discussing backend engineering challenges, distributed architectures, high-throughput systems, or full-time opportunities.
          </p>
          <div class="contact-buttons">
            <a class="btn btn-primary" href="mailto:kumaresk002@gmail.com">
              <span>Send an email</span>
              <span aria-hidden="true">↗</span>
            </a>
            <a class="btn btn-secondary" href="https://www.linkedin.com/in/kumaresan-k-4289452b4" target="_blank" rel="noopener">
              <span>LinkedIn Profile</span>
              <span aria-hidden="true">↗</span>
            </a>
            <a class="btn btn-secondary" href="https://github.com/kuman002" target="_blank" rel="noopener">
              <span>GitHub Projects</span>
              <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <!-- Clean Footer -->
  <footer class="footer">
    <div class="container footer-content">
      <span>© 2026 Kumaresan Kanthasamy · Backend & Cloud Systems Engineer</span>
      <span>Designed for simplicity, speed & clean performance</span>
    </div>
  </footer>
</BaseLayout>
